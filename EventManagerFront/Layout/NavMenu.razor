@inject IJSRuntime JS
@inject NavigationManager Nav
@inject EventManagerFront.Services.AuthService AuthService

<div class="nav-header">
    <a class="nav-brand" href="dashboard">EventManager</a>
</div>

<div class="nav-menu">
    @if (isLoggedIn)
    {
        <a class="nav-item" href="dashboard">📅Mis Eventos</a>
        <button class="nav-item nav-btn" @onclick="Logout">Cerrar Sesión</button>
    }
    else
    {
        <a class="nav-item" href="login">Iniciar Sesión</a>
        <a class="nav-item" href="register">Registrarse</a>
    }
</div>

@code {
    private bool isLoggedIn = false;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnChange += UpdateLoginState;
        var token = await JS.InvokeAsync<string>("storage.get", "token");
        isLoggedIn = !string.IsNullOrEmpty(token);
    }

    private void UpdateLoginState()
    {
        isLoggedIn = AuthService.IsLoggedIn;
        StateHasChanged();
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("storage.set", "token", "");
        AuthService.SetLoggedIn(false);
        Nav.NavigateTo("/login");
    }
}