@page "/event/{id}"
@using EventManagerFront.Models
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="detail-container">
    <button class="btn-small" @onclick='() => Nav.NavigateTo("/dashboard")'>← Volver</button>

    @if (evento == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <div class="detail-card">
            <div class="detail-header">
                <h1>@evento.Type</h1>
                <span class="event-state">@evento.Es</span>
            </div>

            <div class="detail-info">
                <div class="detail-item">
                    <span class="detail-label">📅 Fecha</span>
                    <span>@evento.Date.ToLocalTime().ToString("dd/MM/yyyy")</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">🕐 Inicio</span>
                    <span>@evento.Date.ToLocalTime().ToString("HH:mm")</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">📍 Lugar</span>
                    <span>@evento.Loc</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">⏱ Duración</span>
                    <span>@evento.Duration horas</span>
                </div>
            </div>
        </div>

        <div class="detail-card">
            <h3>Contactos</h3>
            @if (evento.Contacts.Count == 0)
            {
                <p style="color: rgba(255,255,255,0.5)">No hay contactos cargados</p>
            }
            else
            {
                @foreach (var c in evento.Contacts)
                {
                    <div class="contact-item">
                        <span>👤 @c.Name</span>
                        <span>📞 @c.Number</span>
                    </div>
                }
            }

            <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
                <input class="login-input" @bind="newContactName" placeholder="Nombre" />
                <input class="login-input" @bind="newContactNumber" placeholder="Número (ej: 1123456789)" />
                <button class="btn-small" @onclick="AddContact">+ Agregar Contacto</button>
                @if (!string.IsNullOrEmpty(contactError))
                {
                    <p class="error-msg">@contactError</p>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private EventDto? evento;
    private string newContactName = "";
    private string newContactNumber = "";
    private string contactError = "";

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("storage.get", "token");

        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.GetFromJsonAsync<GetEventByIdResponse>($"/dj/event/{Id}");
        evento = response?.E;
    }

    private async Task AddContact()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("storage.get", "token");
            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.PostAsJsonAsync(
                $"/dj/event/{Id}/contact",
                new { name = newContactName, number = newContactNumber }
            );

            if (response.IsSuccessStatusCode)
            {
                newContactName = "";
                newContactNumber = "";
                contactError = "";
                var updated = await Http.GetFromJsonAsync<GetEventByIdResponse>($"/dj/event/{Id}");
                evento = updated?.E;
            }
            else
            {
                contactError = await response.Content.ReadAsStringAsync();
            }
        }
        catch
        {
            contactError = "Error al agregar contacto";
        }
    }
}